{
  "name": "default-branch-path-scoped-reviewers",
  "target": "branch",
  "enforcement": "evaluate",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    },
    "repository_name": {
      "include": ["~ALL"],
      "exclude": ["openjd-samples", ".github"],
      "protected": false
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "required_reviewers": [
          {
            "minimum_approvals": 2,
            "reviewer": { "id": 8513209, "type": "Team" },
            "file_patterns": ["src/**", "test/**", "crates/**", "rust-bindings/**", "_build_backend.py", "testing_containers/**"]
          },
          {
            "minimum_approvals": 2,
            "reviewer": { "id": 9063488, "type": "Team" },
            "file_patterns": ["conformance-tests/**", "wiki/*-Template-Schemas.md", "wiki/*-Expression-Language.md"]
          }
        ]
      }
    }
  ],
  "bypass_actors": []
}
